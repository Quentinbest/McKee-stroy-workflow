{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mckee-story-workflow.local/schemas/artifact.schema.json",
  "title": "Story Workflow Artifact Contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "required_input_version",
    "producers",
    "consumers",
    "validation",
    "human_checkpoint",
    "allowed_backward_transitions",
    "stop_loss"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "required_input_version": { "type": ["string", "null"] },
    "producers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "consumers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "human_checkpoint": { "type": "boolean" },
    "allowed_backward_transitions": { "type": "array", "items": { "type": "string" } },
    "stop_loss": { "type": "string", "minLength": 3 }
  },
  "additionalProperties": false
}
