{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mckee-story-workflow.local/schemas/role-contract.schema.json",
  "title": "Canonical Role Contract",
  "type": "object",
  "required": [
    "purpose",
    "mode",
    "inputs",
    "outputs",
    "allowed_paths",
    "forbidden_actions",
    "verification",
    "handoff"
  ],
  "properties": {
    "purpose": { "type": "string", "minLength": 3 },
    "mode": { "enum": ["read_only", "scoped_write"] },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "handoff": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
