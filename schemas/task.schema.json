{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mckee-story-workflow.local/schemas/task.schema.json",
  "title": "McKee Story Workflow Task Contract",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "priority",
    "owner",
    "created",
    "updated",
    "risk",
    "approval_required",
    "scope",
    "depends_on"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "proposed",
        "ready",
        "in_progress",
        "verification",
        "review",
        "blocked",
        "done",
        "cancelled",
        "stale"
      ]
    },
    "priority": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{4}-[0-9]{3}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
