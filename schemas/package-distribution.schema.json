{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mckee-story-workflow.local/schemas/package-distribution.schema.json",
  "title": "McKee Story Workflow Package Distribution",
  "type": "object",
  "required": ["schemaVersion", "skillCatalog", "packages"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skillCatalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "classification"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "classification": {
            "enum": ["core", "workflow", "wiki-maintainer"]
          }
        },
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "edition",
          "description",
          "includeClassifications",
          "conflicts",
          "roleMode",
          "requiresStoryProject",
          "wikiMode",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^mckee-story-[a-z0-9-]+$"
          },
          "edition": {
            "enum": ["core", "workflow", "wiki-maintainer"]
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "includeClassifications": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["core", "workflow", "wiki-maintainer"]
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^mckee-story-[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "roleMode": {
            "enum": ["fallback-only", "native-or-fallback", "wiki-only"]
          },
          "requiresStoryProject": {
            "type": "boolean"
          },
          "wikiMode": {
            "enum": ["offline-optional", "project-required"]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["claude", "codex", "cursor", "opencode", "pi"]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
