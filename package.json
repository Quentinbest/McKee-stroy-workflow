{
  "name": "mckee-story-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-harness McKee story workflow agent framework",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agents:bootstrap": "node scripts/bootstrap-agent-env.mjs",
    "agents:sync": "node scripts/sync-harness-adapters.mjs",
    "agents:check-drift": "node scripts/check-generated-drift.mjs",
    "agents:lint": "node scripts/verify-instruction-graph.mjs && node scripts/verify-documentation.mjs",
    "agents:test:contracts": "node scripts/verify-task-contracts.mjs && node scripts/verify-skill-contracts.mjs",
    "agents:test:security": "node scripts/verify-security.mjs && node --test tests/security/security.test.mjs",
    "agents:test": "node scripts/verify-agent-framework.mjs",
    "agents:verify": "npm run agents:bootstrap && npm run agents:lint && npm run agents:test:contracts && npm run agents:sync && npm run agents:check-drift && npm run agents:test:security && npm run agents:test",
    "agents:smoke:claude": "node scripts/smoke-harness.mjs claude",
    "agents:smoke:cursor": "node scripts/smoke-harness.mjs cursor",
    "agents:smoke:pi": "node scripts/smoke-harness.mjs pi",
    "agents:smoke:opencode": "node scripts/smoke-harness.mjs opencode",
    "agents:smoke:codex": "node scripts/smoke-harness.mjs codex"
  }
}
